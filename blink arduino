// Loop function runs repeatedly
void loop() {
  // Turn the LED on
  digitalWrite(ledPin, HIGH);
  
  // Wait for one second
  delay(1000);

  // Turn the LED off
  digitalWrite(ledPin, LOW);
  
  // Wait for 1000 second
  delay(1000000);
}



